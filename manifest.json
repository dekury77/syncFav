{
  "manifest_version": 3,
  "name": "FavoSync - Cross-Browser Bookmark Sync",
  "version": "1.2.3",
  "description": "Google Drive를 통해 Ego Lite, Chrome 등 모든 Chromium 브라우저 간 즐겨찾기를 자동 동기화합니다.",
  "permissions": [
    "bookmarks",
    "storage",
    "identity",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://syncfav-oauth-proxy.muon-plaza-3d-portal.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FavoSync - 즐겨찾기 동기화",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "key": ""
}
